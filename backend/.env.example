# Server & Environment
PORT=4000
NODE_ENV=development

# Database configuration (Neon Cloud PostgreSQL)
# DATABASE_URL: Pooled connection string (with ?sslmode=require&pgbouncer=true) for high-performance application runtime
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: Direct unpooled connection string (port 5432) for running Prisma schema migrations
DIRECT_URL="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Authentication secrets (Generate strong random 64-char strings)
AUTH_SECRET="your-super-secret-jwt-access-key-minimum-32-chars"
AUTH_REFRESH_SECRET="your-super-secret-jwt-refresh-key-minimum-32-chars"

# AI Provider Configuration (Groq API for LLM & Whisper Speech-to-Text & Vision OCR)
AI_PROVIDER=groq
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL=openai/gpt-oss-120b

# Code Execution Sandbox Configuration
# When running in production or outside Docker, configure a remote sandbox runner (e.g. Judge0, Piston, or container sandbox service)
SANDBOX_SERVICE_URL=
SANDBOX_API_KEY=

# File Storage (Cloudinary Object Storage or local)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# CORS & Frontend Origins (Comma-separated origins)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Gmail SMTP Mail Service (For 2FA / Login OTP verification)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM="Nexora <noreply@nexora.de>"

# Database Seed Configuration (Set true only if you want demo applicant fixtures seeded in production)
ENABLE_DEMO_SEED=false
