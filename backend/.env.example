PORT=4000
NODE_ENV=development

# Database configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexora

# Authentication secrets
AUTH_SECRET=
AUTH_REFRESH_SECRET=

# AI Provider (e.g. groq, gemini)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Object Storage configuration (local or s3)
STORAGE_PROVIDER=local
STORAGE_BUCKET_OR_ACCOUNT=nexora-storage
STORAGE_LOCAL_PATH=./storage/uploads

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Mail configuration
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
