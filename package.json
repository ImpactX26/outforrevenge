{
  "name": "nexora",
  "version": "1.0.0",
  "description": "Nexora - Your intelligent journey to Germany. Agentic AI applicant journey platform.",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run backend\" \"npm run frontend\"",
    "backend": "npm --prefix backend run start:dev",
    "frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "test": "npm --prefix backend run test",
    "seed": "npm --prefix backend run seed",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
